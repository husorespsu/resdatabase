APP_NAME="PSU Research Management"
APP_URL=http://localhost/research
APP_BASE_URL=/research
APP_ENV=local
APP_DEBUG=false
APP_KEY=your_app_key_here

# Database (PostgreSQL / Neon)
DB_DRIVER=pgsql
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_password_here
DB_SSLMODE=require

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/research/auth/google/callback
ALLOWED_DOMAINS=psu.ac.th,gmail.com

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME="PSU Research System"
MAIL_FROM_ADDRESS=noreply@psu.ac.th
